# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=123456:replace_with_your_bot_token

# Numeric Telegram chat ID of Karina (usually a positive user ID).
KARINA_CHAT_ID=123456789

LOG_LEVEL=INFO

# Optional: set this for webhook mode; leave unset to use long polling locally.
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook
# Optional secret token for authenticating webhook requests.
WEBHOOK_SECRET=
